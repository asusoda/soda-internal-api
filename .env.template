# Every setting of Platform, with a comment. Set them in Doppler (docs/operations.md, "Settings").
# Platform reads no .env file.

TIMEZONE=America/Phoenix
IS_PROD=false
 
# URLs
CLIENT_URL=https://admin.thesoda.io  # sign-in from a client other than the dashboard returns here
DASHBOARD_URL=  # officer dashboard URL, for CORS and the sign-in return
# CORS_EXTRA_ORIGINS=  # more allowed origins, comma-separated (e.g., http://localhost:5000)
VITE_API_URL=https://api.thesoda.io  # API URL, read by the dashboard container at startup (docker-compose.yml)
REDIRECT_URI=https://api.thesoda.io/api/auth/callback  # <API URL>/api/auth/callback, a redirect of the Discord app

# secrets
NOTION_API_KEY=  # default Notion token; each org can set its own on the Integrations page
GOOGLE_SERVICE_ACCOUNT=  # JSON key of the Google service account for Google Calendar; each org can set its own on the Integrations page
BOT_TOKEN=  # bot token of the Discord app of CLIENT_ID
SECRET_KEY=  # signs Flask session cookies (FLASK_SECRET_KEY takes precedence); use a long random value
CLIENT_ID=  # OAuth client id of the same Discord app as BOT_TOKEN
CLIENT_SECRET=  # OAuth client secret of the same Discord app
# RUN_BOT=false  # deploy/runpod/start.sh: do not start the bot when another process uses BOT_TOKEN
# RUN_BOT_IN_API=true  # main.py starts the bot in a thread; docker-compose.yml sets false and runs bot_main.py
CLERK_SECRET_KEY=  # for clerk authentication
CLERK_AUTHORIZED_PARTIES=  # comma-separated list of authorized origins (e.g., https://thesoda.io,https://localhost:5173)
SYS_ADMIN=  # Discord user id of the platform superadmin, or a comma-separated list of ids
SENTRY_DSN=  # for error tracking and logging (e.g., https://...@o...ingest.us.sentry.io/...)
# SENTRY_ENVIRONMENT=production  # the environment name on each Sentry event
# SENTRY_TRACES_SAMPLE_RATE=0.1  # share of requests sent as traces, 0 to 1
# SENTRY_PROFILES_SAMPLE_RATE=0  # share of traces that are also profiled, 0 to 1
# SENTRY_LOGS_LEVEL=WARNING  # the lowest log level sent to Sentry Logs

# LeetCode daily bot
LEETCODE_CHANNEL_ID=  # channel ID where daily problems are posted
LEETCODE_ROLE_PING=  # (optional) role ID to ping with each daily post
LEETCODE_DAILY_TIME=09:00  # time to post daily question (HH:MM, uses TIMEZONE above)

# Database location. Defaults to sqlite:///./data/user.db when unset.
# DATABASE_URL=sqlite:///./data/user.db

# Access checks. false logs requests that would be refused (access decision=would_deny); true refuses them.
ACCESS_ENFORCE=false

# Path prefixes that answer 404 like an unknown route, comma-separated (docs/operations.md).
# Empty = every route is on.
DISABLED_ROUTES=

# Background jobs and audit (docs/architecture.md, "Jobs")
# CALENDAR_SYNC_CRON=0 */2 * * *  # unset = calendar sync only when someone calls /sync
# AUDIT_RETENTION_DAYS=365
# ERROR_RETENTION_DAYS=90  # days an error group is kept after it was last seen
# ERROR_WEBHOOK_URL=  # Discord webhook that gets a message for each new error of every org and of the server. Org webhooks are set on the dashboard Webhooks page
# AGENT_RETENTION_DAYS=180  # idle agent conversations are deleted after this
# UPTIME_RETENTION_DAYS=30  # uptime checks are deleted after this
# JOBS_BACKEND=  # inline or procrastinate; unset = procrastinate on Postgres, inline otherwise

# Logs and the MCP server
# LOG_FORMAT=text  # json writes one JSON object per line; docker-compose.yml sets json
# MCP_PORT=8001

# Knowledge search (docs/modules/knowledge.md). Each org can set its own embeddings, OpenRouter, Firecrawl and
# SearXNG on the dashboard's Integrations page; these are the defaults for orgs that set none.
# Without an embeddings service, writers send their own vectors and search runs on text alone.
# EMBEDDINGS_URL=http://llama-embed:8080/v1
# EMBEDDINGS_MODEL=qwen3-embedding-0.6b
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_QUERY_PREFIX=
# OPENROUTER_API_KEY=  # default OpenRouter key; Embeddings uses it when EMBEDDINGS_URL is https://openrouter.ai/api/v1 and EMBEDDINGS_API_KEY is empty
# KNOWLEDGE_MAX_DISTANCE=0.6
# KNOWLEDGE_PUBLISHERS=  # org prefixes allowed to write sources every org can search; the superadmin can add more on the dashboard
# KNOWLEDGE_USER_AGENT=PlatformKnowledgeBot/1.0
# KNOWLEDGE_CHUNK_CHARS=300  # default passage size; each org can change it on the dashboard
# KNOWLEDGE_CRAWL_BATCH=20  # sources crawled in each run of knowledge.crawl_due
# KNOWLEDGE_CRAWL_GAP_SECONDS=2  # time between fetches to one host
# FIRECRAWL_URL=http://firecrawl:3002  # renders JavaScript pages; unset = plain GET
# FIRECRAWL_API_KEY=
# SEARXNG_URL=http://searxng:8080  # web search for the web live query of a submodule; unset = that query answers 503
# SEARXNG_ENGINES=google,brave,bing
# PACK_QUERY_MAX_CHARS=30000

# Connected accounts (docs/modules/accounts.md). Needs SECRETS_KEY. Add
# <ACCOUNTS_BASE_URL>/api/accounts/discord/callback to the Discord app's redirect URLs, and
# <ACCOUNTS_BASE_URL>/api/accounts/<provider>/callback to each provider's app.
# ACCOUNTS_BASE_URL=https://api.example.org
# ACCOUNTS_GOOGLE_CLIENT_ID=
# ACCOUNTS_GOOGLE_CLIENT_SECRET=
# ACCOUNTS_CANVAS_CLIENT_ID=
# ACCOUNTS_CANVAS_CLIENT_SECRET=
# ACCOUNTS_CANVAS_URL=https://canvas.example.edu  # unset = the canvas_url of the one submodule that sets it
# ACCOUNTS_MICROSOFT_CLIENT_ID=
# ACCOUNTS_MICROSOFT_CLIENT_SECRET=

# Encrypts per-org secrets (PUT /api/organizations/<id>/secrets/<name>). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first: SECRETS_KEY=new,old
SECRETS_KEY=

# Tools of connected services for agents (docs/integrations.md)
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/  # the GitHub MCP server that the github.* agent tools go through
# RUNPOD_MCP_URL=https://mcp.getrunpod.io/  # the RunPod MCP server that the runpod.* agent tools go through
# NOTION_MCP_URL=https://mcp.notion.com/mcp  # the Notion MCP server that signed-in notion.* agent tools go through

# Godfather pods (docs/modules/godfather.md)
# GODFATHER_CLI_NAME=godfather  # CLI name in sign-in pages and errors; COMPUTE_CLI_NAME still works
# GODFATHER_POD_IMAGE=ghcr.io/theaisocietyasu/godfather-base:latest  # default pod image (COMPUTE_POD_IMAGE still works); each org can set its own under Godfather > Settings
