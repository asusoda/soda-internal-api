# Build stage
FROM mirror.gcr.io/library/node:26-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files for better caching
COPY web/package.json web/pnpm-lock.yaml ./

# Install pnpm. Node 25 and later do not include corepack, so download the
# version in packageManager and check it against the SHA-512 hash there.
RUN set -e; \
    pm="$(node -p "require('./package.json').packageManager")"; \
    version="${pm#pnpm@}"; version="${version%%+*}"; \
    npm pack "pnpm@$version" --pack-destination /tmp --silent; \
    mv "/tmp/pnpm-$version.tgz" /tmp/pnpm.tgz; \
    echo "${pm##*+sha512.}  /tmp/pnpm.tgz" | sha512sum -c -; \
    npm install -g /tmp/pnpm.tgz

# Install dependencies
RUN pnpm install --frozen-lockfile --prefer-offline

# Copy source code
COPY web/ ./

# Accept build arguments
ARG REACT_APP_API_URL

# Build the application
RUN pnpm run build

# Production stage
FROM mirror.gcr.io/library/node:26-alpine

# Install pnpm from the checked tarball of the build stage, and serve globally
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
COPY --from=builder /tmp/pnpm.tgz /tmp/pnpm.tgz
RUN npm install -g /tmp/pnpm.tgz && rm /tmp/pnpm.tgz && mkdir -p $PNPM_HOME && pnpm add -g serve

# Create a non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S appuser -u 1001

# Set working directory
WORKDIR /app

# Copy built application from builder stage
COPY --from=builder --chown=appuser:nodejs /app/build ./build

# Switch to non-root user
USER appuser

# Expose port 5000
EXPOSE 5000

# Start the application
CMD ["serve", "-s", "build", "-l", "5000"]
