# Build stage
FROM mirror.gcr.io/library/python:3.12-slim AS builder

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /usr/local/bin/uv

# Install the Doppler CLI. The entrypoint gets the settings from Doppler with it.
COPY deploy/install-doppler.sh /tmp/install-doppler.sh
RUN /tmp/install-doppler.sh /opt/doppler

# Set working directory
WORKDIR /app

# Copy dependency files first (better caching)
COPY pyproject.toml uv.lock ./

# Install the runtime dependencies, without the dev group
RUN uv sync --locked --no-dev

# Runtime stage
FROM mirror.gcr.io/library/python:3.12-slim

# Accept build argument for commit hash
ARG COMMIT_HASH=unknown

# Install only runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* && \
    useradd -m appuser && \
    mkdir -p /app/data

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /opt/doppler/doppler /usr/local/bin/doppler
COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
ENV PATH="/app/.venv/bin:$PATH"

# Set commit hash as environment variable
ENV GIT_COMMIT_HASH=${COMMIT_HASH}

# Copy application code
COPY --chown=appuser:appuser modules ./modules
COPY --chown=appuser:appuser core ./core
COPY --chown=appuser:appuser submodules ./submodules
COPY --chown=appuser:appuser apps ./apps
COPY --chown=appuser:appuser alembic ./alembic
COPY --chown=appuser:appuser alembic.ini ./
COPY --chown=appuser:appuser *.py ./

# Switch to non-root user
USER appuser

# Expose the port
EXPOSE 8000

# Run the application with the settings from Doppler
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["python3", "main.py"]
