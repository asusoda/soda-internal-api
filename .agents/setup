#!/usr/bin/env bash
# Prepare a fresh Amp orb: the Node version in .nvmrc, Python 3.12 and the uv
# environment, the Doppler CLI and the npm dependencies of dashboard/ and site/.
# Safe to run again on a warm orb.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

# CI and the Docker images use the Node major version in .nvmrc. When the orb
# Node in /usr/local/bin is a different version, keep it for the orb tools that
# use it, install the pinned version next to it and put that version first on
# PATH for shells in this repo.
repo_root="$PWD"
node_major="$(tr -d ' v\n' < .nvmrc)"
node_dir="$HOME/.local/share/node-$node_major"

install_node() {
  local system_node
  system_node="$(command -v node || true)"
  if [ -n "$system_node" ] && [ "$("$system_node" -p 'process.versions.node.split(".")[0]')" = "$node_major" ]; then
    echo "The orb Node $("$system_node" --version) matches .nvmrc"
    return
  fi
  if [ -x "$node_dir/bin/node" ]; then
    echo "Node $("$node_dir/bin/node" --version) is installed"
    return
  fi
  local arch tmp base
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "No Node build for $(uname -m)" >&2; return 1 ;;
  esac
  tmp="$(mktemp -d)"
  base="https://nodejs.org/dist/latest-v$node_major.x"
  # The subshell removes the download when a step fails, too.
  (
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL "$base/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
    tarball="$(grep -o "node-v[0-9.]*-linux-$arch\.tar\.xz" "$tmp/SHASUMS256.txt")"
    curl -fsSL "$base/$tarball" -o "$tmp/$tarball"
    (cd "$tmp" && grep " $tarball\$" SHASUMS256.txt | sha256sum -c --quiet -)
    mkdir -p "$tmp/node"
    tar -xJf "$tmp/$tarball" -C "$tmp/node" --strip-components=1
    mkdir -p "$(dirname "$node_dir")"
    mv "$tmp/node" "$node_dir"
  )
  echo "Installed Node $("$node_dir/bin/node" --version)"
}

# Login shells that start in the repo read .nvmrc again, so a new pin needs
# only a new setup run.
add_node_to_profile() {
  local marker="# platform: Node from .nvmrc"
  if grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    echo "~/.bash_profile already has the Node hook"
    return
  fi
  cat >> "$HOME/.bash_profile" <<PROFILE

$marker
case "\$PWD/" in
  "$repo_root"/*)
    _node_bin="\$HOME/.local/share/node-\$(tr -d ' v\\n' < "$repo_root/.nvmrc" 2>/dev/null)/bin"
    case ":\$PATH:" in
      *":\$_node_bin:"*) ;;
      *) [ -d "\$_node_bin" ] && export PATH="\$_node_bin:\$PATH" ;;
    esac
    unset _node_bin
    ;;
esac
PROFILE
  echo "Added the Node hook to ~/.bash_profile"
}

step "install Node $node_major" install_node
step "Node PATH hook" add_node_to_profile
export PATH="$node_dir/bin:$PATH"

# uv installs Python 3.12 (pyproject.toml needs >=3.12,<3.13) when it is missing.
step "uv sync" uv sync --frozen --python 3.12

# The settings come from Doppler (docs/operations.md, "Settings"). make ci does
# not need them.
step "Doppler CLI" deploy/install-doppler.sh "$HOME/.local/bin"

# npm ci deletes node_modules each time, so skip it when the installed tree
# still matches the lockfile. The marker holds the lockfile hash and the Node
# version of the last install. npm ls fails when a package is missing.
npm_install() {
  local dir="$1" marker="$1/node_modules/.amp-setup-lock" want
  want="$(sha256sum "$dir/package-lock.json" | cut -d' ' -f1) node-$(node -p 'process.versions.node.split(".")[0]')"
  if [ "$(cat "$marker" 2>/dev/null)" = "$want" ] &&
    (cd "$dir" && npm ls --all >/dev/null 2>&1); then
    echo "$dir/node_modules is up to date"
    return
  fi
  (cd "$dir" && npm ci --no-audit --no-fund --prefer-offline)
  echo "$want" > "$marker"
}

step "npm ci dashboard" npm_install dashboard
step "npm ci site" npm_install site
