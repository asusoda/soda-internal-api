# Builds the officer dashboard and the member store (dashboard/) and serves them on port 5001.
FROM mirror.gcr.io/library/node:26-alpine AS builder
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
RUN npm run build

FROM mirror.gcr.io/library/node:26-alpine
RUN npm install -g serve@14 && addgroup -g 1001 -S nodejs && adduser -S appuser -u 1001
WORKDIR /app
COPY --from=builder --chown=appuser:nodejs /app/dist ./dist
COPY deploy/frontend-config.mjs /usr/local/lib/frontend-config.mjs
COPY deploy/dashboard-serve.json ./serve.json
USER appuser
EXPOSE 5001
# VITE_API_URL and VITE_SITE_URL come from the container env. The container stops when VITE_API_URL is empty.
CMD ["sh", "-c", "node /usr/local/lib/frontend-config.mjs dist/config.js VITE_API_URL:required VITE_SITE_URL && exec serve -s dist -l 5001 --config /app/serve.json"]
