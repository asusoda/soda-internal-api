# Builds the officer dashboard and the member store (dashboard/) and serves them on port 5001.
FROM mirror.gcr.io/library/node:26-alpine AS builder
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
# The API URL and the landing site URL go into the bundle at build time.
ARG VITE_API_URL
ARG VITE_SITE_URL
ENV VITE_API_URL=$VITE_API_URL VITE_SITE_URL=$VITE_SITE_URL
# The build stops when VITE_API_URL is empty.
RUN test -n "$VITE_API_URL" || (echo "VITE_API_URL is not set. Set it in Doppler (for example https://api.thesoda.io) and build again." >&2; exit 1)
RUN npm run build

FROM mirror.gcr.io/library/node:26-alpine
RUN npm install -g serve@14 && addgroup -g 1001 -S nodejs && adduser -S appuser -u 1001
WORKDIR /app
COPY --from=builder --chown=appuser:nodejs /app/dist ./dist
USER appuser
EXPOSE 5001
CMD ["serve", "-s", "dist", "-l", "5001"]
